# Plantilla de backend/.env (CC-12, CC-20, CC-21).
# Copiar a backend/.env y llenar los valores. backend/.env nunca se versiona.
# Solo ASCII: sin acentos ni simbolos especiales en la contrasena de PostgreSQL.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=supply_chain_final
DB_USER=postgres
DB_PASSWORD=

# Banxico SIE, tipo de cambio FIX (serie SF43718)
BANXICO_TOKEN=

# Z.AI, asistente de IA (modelos gratuitos GLM-4.7-Flash y GLM-4.5-Flash)
ZAI_API_KEY=

# Canal interno Tomcat-FastAPI: SC_TOKEN_INTERNO lo agrega python -m admin.token_interno;
# no se escribe a mano.

# Opcional: respaldo local del asistente con Ollama
# OLLAMA_URL=http://localhost:11434/v1/chat/completions
# OLLAMA_MODELO=qwen2.5:7b