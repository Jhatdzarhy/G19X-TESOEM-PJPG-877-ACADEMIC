<%--
  Cabecera comun de las vistas del dashboard (diseno CC-10; vistas por modulo CC-24).
  Abre el documento, pinta el menu lateral con el Resumen y los 8 modulos del PDR y abre
  el contenido. Requiere en request: vista, titulo y usuario (PaginaServlet).
  data-rol solo ajusta la interfaz; cada Servlet vuelve a validar el rol (CC-20).
  Todo dato variable pasa por sc:esc (prevencion de XSS).
--%>
<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="sc" uri="/WEB-INF/sc.tld" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="${sc:esc(usuario.csrf)}">
    <title>${sc:esc(titulo)} · Supply Chain</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          integrity="sha256-2FMn2Zx6PuH5tdBQDRNwrOo60ts5wWPC9R8jK67b3t4=" crossorigin="anonymous">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css?v=${sc:esc(version)}">
</head>
<body class="pagina-app" data-ctx="${sc:esc(pageContext.request.contextPath)}" data-rol="${sc:esc(usuario.rol)}">
<aside class="menu">
    <div class="menu-marca">
        <span class="marca-titulo">SUPPLY CHAIN</span>
        <span class="marca-sub">PluriOne · Dashboard ejecutivo</span>
    </div>
    <nav class="menu-enlaces" aria-label="Módulos">
        <a class="${vista == 'resumen' || vista == 'actividad' ? 'activo' : ''}" href="${pageContext.request.contextPath}/resumen"
           ${vista == 'resumen' || vista == 'actividad' ? 'aria-current="page"' : ''}>Resumen ejecutivo</a>
        <a class="${vista == 'compras' ? 'activo' : ''}" href="${pageContext.request.contextPath}/compras"
           ${vista == 'compras' ? 'aria-current="page"' : ''}>Compras</a>
        <a class="${vista == 'inventarios' ? 'activo' : ''}" href="${pageContext.request.contextPath}/inventarios"
           ${vista == 'inventarios' ? 'aria-current="page"' : ''}>Inventarios</a>
        <a class="${vista == 'logistica' ? 'activo' : ''}" href="${pageContext.request.contextPath}/logistica"
           ${vista == 'logistica' ? 'aria-current="page"' : ''}>Logística y transporte</a>
        <a class="${vista == 'almacenes' ? 'activo' : ''}" href="${pageContext.request.contextPath}/almacenes"
           ${vista == 'almacenes' ? 'aria-current="page"' : ''}>Almacenes</a>
        <a class="${vista == 'proveedores' ? 'activo' : ''}" href="${pageContext.request.contextPath}/proveedores"
           ${vista == 'proveedores' ? 'aria-current="page"' : ''}>Proveedores</a>
        <a class="${vista == 'soluciones' || vista == 'asistente' ? 'activo' : ''}" href="${pageContext.request.contextPath}/soluciones"
           ${vista == 'soluciones' || vista == 'asistente' ? 'aria-current="page"' : ''}>Inteligencia artificial</a>
        <a class="${vista == 'alertas' ? 'activo' : ''}" href="${pageContext.request.contextPath}/alertas"
           ${vista == 'alertas' ? 'aria-current="page"' : ''}>Alertas ejecutivas</a>
        <a class="${vista == 'administracion' ? 'activo' : ''}" href="${pageContext.request.contextPath}/administracion"
           ${vista == 'administracion' ? 'aria-current="page"' : ''} ${usuario.rol == 'ADMIN' ? '' : 'hidden'}>Administración</a>
    </nav>
    <div class="menu-usuario">
        <span class="menu-usuario-nombre">${sc:esc(usuario.nombre)}</span>
        <span class="menu-usuario-rol">Rol: ${sc:esc(usuario.rolVisible)}</span>
        <form method="post" action="${pageContext.request.contextPath}/logout">
            <input type="hidden" name="_csrf" value="${sc:esc(usuario.csrf)}">
            <button type="submit" class="boton boton-secundario">Cerrar sesión</button>
        </form>
    </div>
</aside>
<main class="contenido">