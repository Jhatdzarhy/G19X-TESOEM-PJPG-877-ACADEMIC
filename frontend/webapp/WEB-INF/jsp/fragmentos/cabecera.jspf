<%--
  Cabecera comun de las vistas del dashboard (diseno CC-10).
  Abre el documento, pinta el menu lateral con los 8 modulos del PDR y abre el
  contenido. Requiere en request: vista, titulo y usuario (PaginaServlet).
  Todo dato variable pasa por sc:esc (prevencion de XSS).
--%>
<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="sc" uri="/WEB-INF/sc.tld" %>
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="${sc:esc(usuario.csrf)}">
    <title>${sc:esc(titulo)} · Supply Chain</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700&display=swap">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          integrity="sha256-2FMn2Zx6PuH5tdBQDRNwrOo60ts5wWPC9R8jK67b3t4=" crossorigin="anonymous">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/css/app.css?v=${sc:esc(version)}">
</head>
<body class="pagina-app" data-ctx="${sc:esc(pageContext.request.contextPath)}">
<aside class="menu">
    <div class="menu-marca">
        <span class="marca-titulo">SUPPLY CHAIN</span>
        <span class="marca-sub">PluriOne · Dashboard ejecutivo</span>
    </div>
    <nav class="menu-enlaces" aria-label="Módulos">
        <a class="${vista == 'resumen' ? 'activo' : ''}" href="${pageContext.request.contextPath}/resumen"
           ${vista == 'resumen' ? 'aria-current="page"' : ''}>Resumen ejecutivo</a>
        <span class="menu-pendiente" aria-disabled="true" title="Disponible próximamente">Compras</span>
        <span class="menu-pendiente" aria-disabled="true" title="Disponible próximamente">Inventarios</span>
        <span class="menu-pendiente" aria-disabled="true" title="Disponible próximamente">Logística y transporte</span>
        <span class="menu-pendiente" aria-disabled="true" title="Disponible próximamente">Almacenes</span>
        <span class="menu-pendiente" aria-disabled="true" title="Disponible próximamente">Proveedores</span>
        <span class="menu-pendiente" aria-disabled="true" title="Disponible próximamente">Inteligencia artificial</span>
        <span class="menu-pendiente" aria-disabled="true" title="Disponible próximamente">Alertas ejecutivas</span>
        <span class="menu-pendiente" aria-disabled="true" title="Disponible próximamente" ${usuario.rol == 'ADMIN' ? '' : 'hidden'}>Administración</span>
    </nav>
    <div class="menu-usuario">
        <span class="menu-usuario-nombre">${sc:esc(usuario.nombre)}</span>
        <span class="menu-usuario-rol">Rol: ${sc:esc(usuario.rolVisible)}</span>
        <form method="post" action="${pageContext.request.contextPath}/logout">
            <input type="hidden" name="_csrf" value="${sc:esc(usuario.csrf)}">
            <button type="submit" class="boton boton-secundario">Cerrar sesión</button>
        </form>
    </div>
</aside>
<main class="contenido">